rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    // Check if user is logged in
    function signedIn() { return request.auth != null; }
    
    // Check if user is owner of the document
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Check if user is Admin (checks 'admins' collection or custom claim)
    function isAdmin() { 
      return signedIn() && (
        request.auth.token.get('admin', false) == true || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }

    // Access Logic: Check if student has paid or owns a specific item
    function hasAccessDoc() { return signedIn() && exists(/databases/$(database)/documents/access/$(request.auth.uid)); }
    function myAccess() { return get(/databases/$(database)/documents/access/$(request.auth.uid)).data; }

    function hasPaid() {
      let a = myAccess();
      return a.get('paid', false) == true && a.get('blocked', false) != true;
    }
    
    function hasItem(key) {
      let a = myAccess();
      let v = a.get('items', {}).get(key, null);
      return a.get('blocked', false) != true && (v != null && (v == 0 || v > request.time.toMillis()));
    }

    // --- COLLECTION RULES ---

    // Admins List: Private
    match /admins/{uid} { allow read: if signedIn(); allow write: if false; }

    // Global Config & Home Banners/Notices: Public Read, Admin Write
    match /config/{d}   { allow read: if true; allow write: if isAdmin(); }
    match /banners/{d}  { allow read: if true; allow write: if isAdmin(); }
    match /notices/{d}  { allow read: if true; allow write: if isAdmin(); }

    // Catalogue: Chapters, Bundles, Tests: Public Read, Admin Write
    match /chapters/{d} { allow read: if true; allow write: if isAdmin(); }
    match /bundles/{d}  { allow read: if true; allow write: if isAdmin(); }
    match /tests/{d}    { allow read: if true; allow write: if isAdmin(); }

    // Paper Vault (PDF Library): Student Read, Admin Write
    match /papers/{d}   { allow read: if signedIn() || isAdmin(); allow write: if isAdmin(); }

    // Secure PDF Links for Paid Notes
    match /chapterFiles/{d} {
      allow read: if isAdmin() || (hasAccessDoc() && (hasPaid() || hasItem(d)));
      allow write: if isAdmin();
    }

    // Secure Test Questions
    match /testQuestions/{d} {
      allow read: if isAdmin() || signedIn(); 
      allow write: if isAdmin();
    }

    // User Profile & Access Info
    match /access/{uid} { allow read: if isOwner(uid) || isAdmin(); allow write: if isAdmin(); }
    match /users/{uid}  { 
      allow read: if isOwner(uid) || isAdmin(); 
      allow create, update: if isOwner(uid); 
      allow delete: if false;
    }

    // Payment Requests (UTR)
    match /payments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn();
      allow update: if isAdmin();
    }

    // Community Help (Posts & Replies)
    match /posts/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.uid == request.auth.uid || resource.data.private == false));
      allow create: if signedIn();
      allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      
      match /replies/{rid} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow delete: if isAdmin();
      }
    }

    // Leaderboard Attempts (Security to prevent score faking)
    match /attempts/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && (request.auth.token.get('admin', false) == true
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    function accessDoc() { return get(/databases/$(database)/documents/access/$(request.auth.uid)).data; }
    function hasPaid() {
      return signedIn() && exists(/databases/$(database)/documents/access/$(request.auth.uid))
        && accessDoc().get('paid', false) == true
        && accessDoc().get('blocked', false) != true
        && (accessDoc().get('untilMs', 0) == 0 || accessDoc().get('untilMs', 0) > request.time.toMillis());
    }
    function owns(item) {
      return signedIn() && exists(/databases/$(database)/documents/access/$(request.auth.uid))
        && accessDoc().get('blocked', false) != true
        && (accessDoc().get('owned', []).hasAny([item])
          || accessDoc().get('ownedUntil', {}).get(item, 0) > request.time.toMillis());
    }
    match /admins/{uid} { allow read: if isOwner(uid) || isAdmin(); allow write: if false; }
    match /config/{id} { allow read: if true; allow write: if isAdmin(); }
    match /chapters/{id} { allow read: if true; allow write: if isAdmin(); }
    // One document per product key (e.g. 1_short), so buying Short Notes cannot expose Full Notes.
    match /chapterFiles/{item} { allow read: if isAdmin() || hasPaid() || owns(item); allow write: if isAdmin(); }
    match /tests/{id} { allow read: if isAdmin() || resource.data.active == true; allow write: if isAdmin(); }
    match /bundles/{id} { allow read: if isAdmin() || resource.data.active == true; allow write: if isAdmin(); }
    match /access/{uid} { allow read: if isOwner(uid) || isAdmin(); allow write: if isAdmin(); }
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','email','phone','name','lastSeen']);
      allow delete: if false;
    }
    match /payments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.utr is string && request.resource.data.utr.size() >= 8 && request.resource.data.utr.size() <= 30
        && request.resource.data.items is list && request.resource.data.items.size() > 0
        && request.resource.data.keys().hasOnly(['uid','email','phone','name','utr','amount','items','bundleId','days','label','status','createdAt']);
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}

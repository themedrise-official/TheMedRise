{
  "hosting": {
    "site": "themedrise",
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "**/*.zip",
      "**/README*"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|json)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
